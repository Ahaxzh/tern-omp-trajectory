--!strict
-- Unit tests for the pure modules (lib/json, lib/parse, lib/query) against
-- two real omp session logs embedded in fixtures.luau (2.8MB, generated by
-- tests/gen_fixtures.sh from ~/.omp/agent/sessions). Run:
--   luau tests/run.luau
-- Ground-truth numbers were measured with jq on the same files; see the
-- delivery report for the omp stats --summary cross-check.

local Json = require("../lib/json")
local Parse = require("../lib/parse")
local Query = require("../lib/query")

-- Real session fixtures are private (full transcripts): they are NOT in the
-- repository. Generate them locally with tests/gen_fixtures.sh; the
-- real-session suites below are skipped when the file is absent.
local has_fixtures, Fixtures = pcall(require, "./fixtures")
if not has_fixtures then
	print("note: tests/fixtures.luau not found — real-session suites skipped")
	print("(generate locally with: tests/gen_fixtures.sh)")
end

local passed = 0
local failed = 0

local function check(name: string, ok: boolean, detail: string?)
	if ok then
		passed += 1
		print("PASS " .. name)
	else
		failed += 1
		print("FAIL " .. name .. (if detail then (" — " .. detail) else ""))
	end
end

local function eq(name: string, got: any, want: any)
	local g, w = tostring(got), tostring(want)
	check(name, g == w, "got " .. g .. ", want " .. w)
end

---------------------------------------------------------------------
-- JSON decoder
---------------------------------------------------------------------

local v = Json.decode('{"a":[1,2,{"b":"c"}],"d":true,"e":null,"f":-1.5e2}')
check("json: nested document", v ~= nil and type(v) == "table")
if type(v) == "table" then
	local t = v :: any
	eq("json: array depth", #t.a, 3)
	eq("json: nested value", t.a[3].b, "c")
	eq("json: true", tostring(t.d), "true")
	eq("json: null dropped", t.e, nil)
	eq("json: exponent number", t.f, -150)
end

eq("json: escapes", Json.decode('"a\\"b\\\\c\\nd\\te"'), 'a"b\\c\nd\te')
eq("json: unicode escape", Json.decode('"\\u00e9"'), "é")
eq("json: surrogate pair", Json.decode('"\\ud83d\\ude00"'), "😀")
eq("json: cjk raw", Json.decode('"优化"'), "优化")
eq("json: slash", Json.decode('"a/b"'), "a/b")
local intdoc = Json.decode('{"x": 0}')
eq("json: int keys", if type(intdoc) == "table" then (intdoc :: any).x else nil, 0)

check("json: rejects trailing", (Json.decode('{} {}') :: any) == nil)
check("json: rejects garbage", (Json.decode('nope') :: any) == nil)
check("json: rejects truncated", (Json.decode('{"a":') :: any) == nil)
check("json: rejects bad escape", (Json.decode('"\\q"') :: any) == nil)
check("json: lone low surrogate decodes leniently", (Json.decode('"\\udc00"') :: any) ~= nil)
check("json: rejects deep nesting", (Json.decode(string.rep("[", 200) .. string.rep("]", 200)) :: any) == nil)

---------------------------------------------------------------------
-- Synthetic parse classification
---------------------------------------------------------------------

local function lines_of(t: { string }): { string }
	return t
end

local synthetic = lines_of({
	'{"type":"session","version":3,"id":"s1","timestamp":"2026-01-01T00:00:00.000Z","cwd":"/tmp/x"}',
	'{"type":"title","v":1,"title":"T","source":"auto","updatedAt":"2026-01-01T00:00:01.000Z"}',
	'{"type":"custom","customType":"system-prompt-digest","data":"abc123","id":"d1","timestamp":"2026-01-01T00:00:02.000Z"}',
	'{"type":"message","id":"m1","timestamp":"2026-01-01T00:00:03.000Z","message":{"role":"user","content":[{"type":"text","text":"hello"}]}}',
	'{"type":"message","id":"m2","timestamp":"2026-01-01T00:00:04.000Z","message":{"role":"assistant","model":"m1","provider":"p","content":[{"type":"thinking","thinking":"hmm"},{"type":"toolCall","id":"c1","name":"bash","arguments":{"command":"ls"},"intent":"list"}],"usage":{"input":10,"output":5,"cacheRead":2,"cacheWrite":0,"totalTokens":15,"cost":{"total":0.01}},"ttft":100.5,"duration":200.25,"stopReason":"toolUse","contextSnapshot":{"compactionEpoch":0}}}',
	'{"type":"custom","customType":"tool_execution_start","data":{"toolCallId":"c1","toolName":"bash","startedAt":"2026-01-01T00:00:04.500Z","intent":"list"},"id":"t1","timestamp":"2026-01-01T00:00:04.500Z"}',
	'{"type":"message","id":"m3","timestamp":"2026-01-01T00:00:05.000Z","message":{"role":"toolResult","toolCallId":"c1","toolName":"bash","content":[{"type":"text","text":"out"}],"details":{"wallTimeMs":12.5},"isError":false}}',
	'{"type":"model_usage","id":"u1","timestamp":"2026-01-01T00:00:06.000Z","purpose":"auto-thinking","model":"m1","usage":{"input":1,"output":1,"cacheRead":0,"cacheWrite":0,"totalTokens":2,"cost":{"total":0.001}}}',
	'{"type":"model_change","id":"mc1","timestamp":"2026-01-01T00:00:07.000Z","model":"glm-5.3"}',
	'this is not json at all',
	'{"type":"brand_new_future_type","id":"f1","timestamp":"2026-01-01T00:00:08.000Z"}',
})

local syn = Parse.lines(synthetic)
local by_kind: { [string]: number } = {}
for _, e in syn.entries do
	by_kind[e.kind] = (by_kind[e.kind] or 0) + 1
end
eq("parse: users", by_kind.user, 1)
eq("parse: assistants", by_kind.assistant, 1)
eq("parse: tools (merged)", by_kind.tool, 1)
eq("parse: system rows", by_kind.system, 5) -- session, title, digest, model_change, future type
eq("parse: usage rows", by_kind.usage, 1)
eq("parse: bad lines", syn.bad, 1)
eq("parse: meta cwd", syn.meta.cwd, "/tmp/x")
eq("parse: meta title", syn.meta.title, "T")
eq("parse: meta digest", syn.meta.digest, "abc123")

local tool: Parse.Entry? = nil
for _, e in syn.entries do
	if e.kind == "tool" then
		tool = e
	end
end
check("parse: tool row exists", tool ~= nil)
if tool then
	local t = tool :: Parse.Entry
	eq("parse: tool args merged from toolCall", tostring((t.args :: any).command), "ls")
	eq("parse: tool result merged", t.result, "out")
	eq("parse: tool wall time", tostring(t.wall_ms), "12.5")
	eq("parse: tool not pending", tostring(t.pending), "false")
end

local assistant: Parse.Entry? = nil
for _, e in syn.entries do
	if e.kind == "assistant" then
		assistant = e
	end
end
check("parse: assistant exists", assistant ~= nil)
if assistant then
	local a = assistant :: Parse.Entry
	check("parse: assistant usage", a.usage ~= nil and (a.usage :: Parse.Usage).total == 15)
	check("parse: assistant ttft", (a.ttft :: number) > 100 and (a.ttft :: number) < 101)
	eq("parse: assistant thinking", a.thinking, "hmm")
	check("parse: iso timestamp plausible", a.ts ~= nil and (a.ts :: number) > 1700000000000 and (a.ts :: number) < 2000000000000,
		"got " .. tostring(a.ts))
end

-- Rounds: one user line -> 1 numbered round + round 0 prologue
local syn_rounds = Query.rounds(syn.entries)
eq("rounds: count", #syn_rounds, 2)
eq("rounds: prologue index", syn_rounds[1].index, 0)
eq("rounds: user round index", syn_rounds[2].index, 1)

-- Compaction epoch increase detection
local comp = Parse.lines(lines_of({
	'{"type":"message","id":"a1","timestamp":"2026-01-01T00:00:00.000Z","message":{"role":"assistant","content":[],"contextSnapshot":{"compactionEpoch":0}}}',
	'{"type":"message","id":"a2","timestamp":"2026-01-01T00:01:00.000Z","message":{"role":"assistant","content":[],"contextSnapshot":{"compactionEpoch":1}}}',
}))
local compactions = 0
for _, e in comp.entries do
	if e.kind == "compaction" then
		compactions += 1
	end
end
eq("parse: compaction detected on epoch increase", compactions, 1)

-- Pagination
local many_rounds: { Query.Round } = {}
for i = 1, 5 do
	table.insert(many_rounds, { index = i, entries = {} })
end
eq("query: tail_from keeps all when few", Query.tail_from(many_rounds, 10), 1)
eq("query: tail_from window", Query.tail_from(many_rounds, 2), 4)

-- Filter
check("query: filter matches tool", Query.entry_matches((tool :: Parse.Entry), "bash"))
check("query: filter misses", not Query.entry_matches((tool :: Parse.Entry), "zzz"))
check("query: empty filter matches all", Query.entry_matches((tool :: Parse.Entry), nil))

-- Formatting
eq("fmt: tokens", Query.fmt_tokens(4459374), "4.5M")
eq("fmt: int", Query.fmt_int(13179414), "13,179,414")
eq("fmt: ms", Query.fmt_ms(5974.79), "6.0s")
eq("fmt: clip", Query.clip("abcdef", 4), "abc…")

---------------------------------------------------------------------
-- Real session A (large, 1.4MB, Blog project)
---------------------------------------------------------------------

if has_fixtures then
local function classify(entries: { Parse.Entry }): ({ [string]: number }, number)
	local kinds: { [string]: number } = {}
	local pending = 0
	for _, e in entries do
		kinds[e.kind] = (kinds[e.kind] or 0) + 1
		if e.kind == "tool" and e.pending then
			pending += 1
		end
	end
	return kinds, pending
end

local fa = Parse.lines(Parse.split(Fixtures.A_text))
local ka, pa = classify(fa.entries)
eq("A: no bad lines", fa.bad, 0)
eq("A: users", ka.user, 18)
eq("A: assistants", ka.assistant, 132)
eq("A: tools (merged to call ids)", ka.tool, 156)
eq("A: system rows", ka.system, 34)
eq("A: usage rows", ka.usage, 13)
eq("A: total entries", #fa.entries, 353)
eq("A: no pending tools after full parse", pa, 0)
eq("A: meta cwd", fa.meta.cwd, "/home/ahaxzh/Projects/GitHub/Blog")
eq("A: meta model", fa.meta.model, "glm-5.3-flash")

local sa = Query.stats(fa.entries, 18)
eq("A: rounds", sa.rounds, 18)
eq("A: requests", sa.requests, 132)
eq("A: tokens total", sa.tokens, 13179414)
check("A: cost total", math.abs(sa.cost - 0.5244054299999998) < 1e-9, "got " .. tostring(sa.cost))
eq("A: aux calls", sa.aux_calls, 13)
eq("A: spark points", #sa.spark, 132)
check("A: ctx grows", (sa.last_ctx :: number) > (sa.first_ctx :: number) * 5,
	"first " .. tostring(sa.first_ctx) .. " last " .. tostring(sa.last_ctx))

local ra = Query.rounds(fa.entries)
local user_rounds_a = 0
for _, r in ra do
	if r.index > 0 then
		user_rounds_a += 1
	end
end
eq("A: user rounds", user_rounds_a, 18)
eq("A: tail window covers all", Query.tail_from(ra, 50), 1)

---------------------------------------------------------------------
-- Real session B (small, 670KB, -Projects-GitHub)
---------------------------------------------------------------------

local fb = Parse.lines(Parse.split(Fixtures.B_text))
local kb, pb = classify(fb.entries)
eq("B: no bad lines", fb.bad, 0)
eq("B: users", kb.user, 11)
eq("B: assistants", kb.assistant, 47)
eq("B: tools", kb.tool, 54)
eq("B: system rows", kb.system, 8)
eq("B: usage rows", kb.usage or 0, 0)
eq("B: total entries", #fb.entries, 120)
eq("B: no pending tools", pb, 0)

local sb = Query.stats(fb.entries, 11)
eq("B: tokens total", sb.tokens, 4459374)
check("B: cost total", math.abs(sb.cost - 0.18151123) < 1e-9, "got " .. tostring(sb.cost))
eq("B: requests", sb.requests, 47)
eq("B: model", sb.model, "glm-5.3-flash")

local rb = Query.rounds(fb.entries)
local user_rounds_b = 0
for _, r in rb do
	if r.index > 0 then
		user_rounds_b += 1
	end
end
eq("B: user rounds", user_rounds_b, 11)

-- Split sanity: fixture B line count matches wc -l (174 lines)
local lb = Parse.split(Fixtures.B_text)
eq("B: split line count", #lb, 174)

end -- has_fixtures

---------------------------------------------------------------------
print(string.format("\n%d passed, %d failed", passed, failed))
if failed > 0 then
	error(failed .. " test(s) failed")
end
